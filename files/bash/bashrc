alias nv="nvim"

if command -v oh-my-posh >/dev/null 2>&1; then
  eval "$(oh-my-posh init bash --config "$HOME/.config/oh-my-posh/distrous-nixos.omp.json")"
fi

# Keep the editable command line distinct from ordinary, uncoloured output.
# PS0 is emitted immediately before Bash runs the command, so command output
# returns to Kitty's default foreground (#b8b8b8).
if [[ $- == *i* ]]; then
  __kitty_original_prompt_command=$PROMPT_COMMAND
  __kitty_coloured_prompt() {
    local previous_status=$?
    ( exit "$previous_status" )
    eval "$__kitty_original_prompt_command"
    PS1+=$'\[\e[38;2;61;174;233m\]'
  }
  PROMPT_COMMAND=__kitty_coloured_prompt
  PS0=$'\e[38;2;184;184;184m'
fi

