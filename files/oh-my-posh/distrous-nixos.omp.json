{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "console_title_template": "{{ if .Root }}root @ {{ end }}{{ .Shell }} in {{ .Folder }}",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#999A98",
          "foreground": "#241F1B",
          "leading_diamond": "\ue0b2",
          "style": "diamond",
          "template": "<b>  NIXOS </b>",
          "type": "os"
        },
        {
          "background": "#B8875D",
          "foreground": "#241F1B",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": "<b> \uf489 {{ .Name }} </b>",
          "type": "shell"
        },
        {
          "background": "#E68C70",
          "foreground": "#241F1B",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": "<b> \uf09c root </b>",
          "type": "root"
        },
        {
          "background": "#A0A48B",
          "foreground": "#241F1B",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": "<b> \ue61e \ue61d cmake {{ .Full }} </b>",
          "type": "cmake"
        },
        {
          "background": "#C5A570",
          "background_templates": [
            "{{ if .Venv}}#A2A099{{ end }}"
          ],
          "foreground": "#241F1B",
          "foreground_templates": [
            "{{ if .Venv }}#241F1B{{ end }}"
          ],
          "powerline_symbol": "\ue0b0",
          "properties": {
            "display_mode": "context"
          },
          "style": "powerline",
          "template": " <b>\ue73c {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}</b> ",
          "type": "python"
        },
        {
          "background": "#8F9E9A",
          "foreground": "#241F1B",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": "<b> ‭\ue626 {{ .Full }} </b>",
          "type": "go"
        },
        {
          "background": "#C08B5E",
          "foreground": "#241F1B",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \ue7a8 {{ .Full }} ",
          "type": "rust"
        },
        {
          "background": "#E87F75",
          "foreground": "#241F1B",
          "powerline_symbol": "\ue0b0",
          "properties": {
            "branch_icon": " ",
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "fetch_worktree_count": true
          },
          "style": "powerline",
          "template": "<b> {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#263F29> \uf046 {{ .Staging.String }}</>{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} </b>",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#CFC3AC",
          "style": "plain",
          "template": "\u256d\u2500",
          "type": "text"
        },
        {
          "style": "plain",
          "template": "  <#F0C879>\uf007 {{ .UserName }}</> <#CFC3AC>|</> <#F0A78E>\udb80\udf79 {{ .HostName }}</>",
          "type": "session"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#CFC3AC",
          "style": "plain",
          "template": "\u2502",
          "type": "text"
        },
        {
          "leading_diamond": "",
          "properties": {
            "folder_icon": " \uf07c ",
            "folder_separator_icon": " <#CFC3AC>\uf061</> ",
            "home_icon": "\uf015",
            "mapped_locations": {
              "~/Desktop": "\uf015 <#CFC3AC>\uf061</> \uf108",
              "~/Documents": "\uf015 <#CFC3AC>\uf061</> \udb80\ude19",
              "~/Downloads": "\uf015 <#CFC3AC>\uf061</> \uf019",
              "~/Music": "\uf015 <#CFC3AC>\uf061</> \uf001",
              "~/Pictures/": "\uf015 <#CFC3AC>\uf061</> \uf03e",
              "~/Videos": "\uf015 <#CFC3AC>\uf061</> \uf03d"
            },
            "max_depth": 4,
            "right_format": "<u><b>%s</b></u>",
            "style": "agnoster_short"
          },
          "style": "diamond",
          "template": "  <#D3EA98>{{ if not .Writable }}<#F49B80>\uf09c {{ end }}{{ if .RootDir }}\ue216{{ else }}{{ .Path }}{{ end }}</> ",
          "type": "path"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#CFC3AC",
          "style": "plain",
          "template": "\u2570\u2500",
          "type": "text"
        },
        {
          "foreground": "#CFC3AC",
          "properties": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "\u276f ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "osc99": true,
  "secondary_prompt": {
    "background": "transparent",
    "foreground": "#CFC3AC",
    "template": "\u2570\u2500\u276f "
  },
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#F4ECE0",
    "template": "\ue285 "
  },
  "version": 3
}
